{
  "manifest_version": 3,
  "name": "Browser Guard",
  "version": "1.0.0",
  "description": "Checks your browser for risky extensions, trackers on the sites you visit, and hijacked connection settings. Everything stays on your computer.",
  "permissions": ["management", "webRequest", "tabs", "storage", "proxy"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Guard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
